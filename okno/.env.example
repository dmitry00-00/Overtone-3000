# Обязательные
OKNO_BOT_TOKEN=            # токен @Overtone_3000_bot из BotFather
OKNO_WEBAPP_URL=           # https-адрес приложения на хостинге (домен, который даст платформа)

# База: хостинг обычно даёт DATABASE_URL — тогда OKNO_DSN не нужен
# OKNO_DSN=postgresql://user:pass@host:5432/okno

# Необязательные
# OKNO_APP_SHORT_NAME=okno # short name из /newapp в BotFather — тогда бот шлёт прямые ссылки t.me/...
# OKNO_TICK_INTERVAL=30    # секунд между проверками дедлайнов
# OKNO_RUN_BOT=1           # 0 — поднять API без бота (например, вторая реплика)
# OKNO_HOST=0.0.0.0        # в Docker уже установлен
# OKNO_PORT=8010           # или платформа задаёт PORT — он тоже понимается
